{
  "name": "vektor-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "draft": "remotion render src/index.ts Vektor out/draft.mp4 --scale 0.5 --crf 24 --concurrency 8",
    "render4k": "remotion render src/index.ts Vektor out/vektor-demo-4k-raw.mp4 --scale 2 --image-format jpeg --jpeg-quality 95 --codec h264 --crf 14 --x264-preset medium --pixel-format yuv420p --audio-codec aac --audio-bitrate 320k --concurrency 13",
    "finish": "node scripts/finish.mjs out/vektor-demo-4k-raw.mp4 out/vektor-demo-4k.mp4",
    "1080p": "ffmpeg -y -i out/vektor-demo-4k.mp4 -vf scale=1920:1080:flags=lanczos -c:v libx264 -crf 16 -preset medium -pix_fmt yuv420p -c:a copy -movflags +faststart out/vektor-demo-1080p.mp4",
    "poster": "remotion still src/index.ts Poster out/vektor-thumbnail.png",
    "typecheck": "tsc --noEmit",
    "voices": "node scripts/voices.mjs",
    "vo": "node scripts/voiceover.mjs",
    "vocheck": "node scripts/vocheck.mjs",
    "sfx": "node scripts/sfx.mjs",
    "music": "node scripts/music.mjs",
    "timing": "node scripts/timing.mjs && node scripts/fixwords.mjs",
    "capture": "node scripts/capture.mjs",
    "encode": "node scripts/encode.mjs",
    "stills": "node scripts/stills.mjs",
    "onchain": "node scripts/onchain.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.530",
    "@remotion/google-fonts": "4.0.530",
    "@remotion/media-utils": "4.0.530",
    "@remotion/paths": "4.0.530",
    "@remotion/shapes": "4.0.530",
    "@remotion/transitions": "4.0.530",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.530",
    "@remotion/renderer": "4.0.530",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.6.0"
  }
}

# ── Vektor terminal (Vite reads VITE_* at dev/build time; restart `npm run dev` after editing) ──

# Your builder code from https://app.strikefinance.org/builder-codes  (REQUIRED for Live mode)
VITE_BUILDER_CODE=

# Fee you charge per fill, in basis points (0–100). Must be ≤ the fee share you registered. 10 = 0.10%.
VITE_BUILDER_FEE_BPS=10

# Network: MAINNET (Strike team confirmed builder codes live here). Testnet = api-v2-testnet.strikefinance.org, but it has no builder codes and empty books.
VITE_API_URL=https://api-v2-testnet.strikefinance.org
VITE_PRICE_URL=https://api-v2-testnet.strikefinance.org/price
VITE_PRICE_WS_URL=wss://api-v2-testnet.strikefinance.org/ws/price
VITE_USER_WS_URL=wss://api-v2-testnet.strikefinance.org/ws/user-api
VITE_STATS_URL=https://api-v2-testnet.strikefinance.org/stat


# ── Headless worker (`npm run worker`; read from the shell environment, e.g. `set -a; source .env; set +a`) ──

# Ed25519 API wallet, raw 64-hex keys, from https://app.strikefinance.org/api-keys  (REQUIRED for the worker)
STRIKE_API_PUBLIC_KEY=
STRIKE_API_PRIVATE_KEY=

# Same network + fee as above
STRIKE_API_URL=https://api-v2-testnet.strikefinance.org
BUILDER_FEE_BPS=10

# Optional
VEKTOR_GRIDS=worker/grids.json
VEKTOR_STATE=worker/state.json
VEKTOR_PORT=8787
VEKTOR_HOST=127.0.0.1
# Bearer token required for POST /panic and /stop/<symbol>; leave empty to disable control endpoints
VEKTOR_TOKEN=
# Comma-separated origins allowed to read the status endpoint (your Vercel URL), * for any
VEKTOR_ALLOW_ORIGIN=*

{
  "name": "vektor",
  "version": "1.0.0",
  "description": "Vektor — CLOB grid studio, funding harvester and liquidation shield on Strike Finance V2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsx scripts/prerender-docs.tsx",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx worker/index.ts",
    "cli": "tsx cli/vektor.ts",
    "autopilot": "tsx server/index.ts",
    "typecheck:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^2.0.1",
    "@solana/web3.js": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-toastify": "^11.0.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "bin": {
    "vektor": "cli/vektor.ts"
  }
}
